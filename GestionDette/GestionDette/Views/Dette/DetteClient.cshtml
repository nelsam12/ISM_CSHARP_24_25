@using Cours.Core
@using Cours.Models
@model PaginationDetteModel


@{
    ViewData["Title"] = "Client Page";
    @* Layout = "_Layout"; *@
}

<div class="card">
    <div class="card-header">Liste clients</div>
    <div class="card-body">
        <div class="my-2 d-flex justify-content-end ">
            <a class="btn btn-outline-dark" asp-action="Create">Nouvelle Dette</a>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Date</th>
                        <th scope="col">Montant</th>
                        <th scope="col">Montant Versé</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dette in Model.Items)
                    {
                        <tr class="">
                            <td>@Html.DisplayFor(modelItem => dette.Id)</td>
                            <td>@Html.DisplayFor(modelItem => dette.Date)</td>
                            <td>@Html.DisplayFor(modelItem => dette.Montant)</td>
                            <td>@Html.DisplayFor(modelItem => dette.MontantVerser)</td>
                            <td>@Html.DisplayFor(modelItem => dette.Status)</td>
                            <td>
                                <a class="btn btn-outline-primary" asp-controller="Paiement" asp-action="PaiementsDette"
                                    asp-route-id="@dette.Id">Paiements</a>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
            @* Partie Dynamique partial *@
            <nav aria-label="Page navigation" class="float-end">
                <ul class="pagination    ">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                                href="@Url.Action("DetteClient", new {clientId = Model.Client.Id,page = Model.CurrentPage - 1})"
                                aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item  @(i==Model.CurrentPage ? "active" : "")" aria-current="page">
                            <a class="page-link"
                                href="@Url.Action("DetteClient", new {clientId = Model.Client.Id,page = i})">@i</a>
                        </li>
                    }
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="DetteClient" asp-route-page="@(Model.CurrentPage + 1)" asp-route-clientId="@Model.Client.Id"
                                aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            @* Partie Dynamique partial *@

        </div>

    </div>

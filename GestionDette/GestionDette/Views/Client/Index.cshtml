@using Cours.Models
@* @model type_de_la_donne *@
@model IEnumerable<Client>


@{
    ViewData["Title"] = "Client Page";
    @* Layout = "_Layout"; *@
}

<div class="table-responsive">
    <table class="table table-primary">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Surnom</th>
                <th scope="col">Telephone</th>
                <th scope="col">Adresse</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr class="">
                    <td>@Html.DisplayFor(modelItem => client.Id)</td>

                    <td>@Html.DisplayFor(modelItem => client.Surnom)</td>

                    <td>@Html.DisplayFor(modelItem => client.Telephone)</td>

                    <td>@Html.DisplayFor(modelItem => client.Adresse)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
